      ],
      "blocks": {
        "styles": {}
      },
      "launch": [
        {
          "order": 1,
          "name": "image-min-tokens",
          "value": 456,
          "description": "Vision budget tuned for Unlimited-OCR."
        },
        {
          "order": 2,
          "name": "image-max-tokens",
          "value": 1156,
          "description": "Vision budget tuned for Unlimited-OCR."
        },
        {
          "order": 3,
          "name": "dry-sequence-breaker",
          "value": "none",
          "description": "Sequences that end DRY repetition tracking; none resets the default list."
        },
        {
          "order": 4,
          "name": "special",
          "description": "Emit special tokens in the server output; the det-token parser needs them."
        }
      ],
      "request": [
        {
          "order": 1,
          "name": "temperature",
          "value": 0.0,
          "description": "Sampling randomness; 0 = deterministic greedy decoding."
        },
        {
          "order": 2,
          "name": "dry_multiplier",
          "value": 0.8,
          "description": "DRY repetition penalty multiplier; 0 disables DRY sampling."
        },
        {
          "order": 3,
          "name": "dry_base",
          "value": 1.75,
          "description": "Base of the exponential penalty growth for repeated sequences."
        },
        {
          "order": 4,
          "name": "dry_allowed_length",
          "value": 35,
          "description": "Number of tokens that may repeat before the penalty applies."
        },
        {
          "order": 5,
          "name": "dry_penalty_last_n",
          "value": 128,
          "description": "Window of recent tokens considered by the DRY penalty."
        },
        {
          "order": 6,
          "name": "stream",
          "value": false,
          "description": "Stream tokens as they arrive; false gives the parser one complete response."
        }
      ]
    }
  }
