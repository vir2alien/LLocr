    "quants": [
      {
        "id": "q8_0",
        "file": "Unlimited-OCR-Q8_0.gguf",
        "sha256": ""
      },
      {
        "id": "q4_k_m",
        "file": "Unlimited-OCR-Q4_K_M.gguf",
