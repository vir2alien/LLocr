    ],
    "mmproj": {
      "id": "f16",
      "file": "mmproj-Unlimited-OCR-F16.gguf",
      "sha256": ""
    }
  },
  "roles": {
    "ocr": {
      "alias": "llocr-unlimited-ocr",
      "parser": "unlimited-ocr",
      "maxOutput": 8192,
      "prompts": [
        {
          "id": "document-parsing",
          "title": "Document parsing",
          "text": "document parsing."
